---
import Base from '../layouts/Base.astro';
import Listing from '../components/Listing.astro';
import { brand } from '../lib/brand';
import { getPosts, PAGE_SIZE } from '../lib/posts';

const posts = await getPosts();
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const heroImage = brand.hero.image;
---

<Base>
  <section class="hero">
    {heroImage && <img class="hero-image" src={heroImage} alt="" width="1600" height="600" fetchpriority="high" />}
    <div class="container">
      <p class="eyebrow">{brand.name}</p>
      <h1>{brand.hero.title}</h1>
      <p>{brand.hero.subtitle}</p>
      <div class="hero-actions">
        <a class="btn primary" href="#artigos">Ler artigos</a>
        <a class="btn" href="/busca">Buscar</a>
        <a class="btn" href="/tags">Explorar por tema</a>
      </div>
    </div>
  </section>
  <section class="section container" id="artigos">
    <div class="section-title"><h2>Artigos recentes</h2><a href="/arquivo">Ver todos →</a></div>
    <Listing posts={posts.slice(0, PAGE_SIZE)} page={1} totalPages={totalPages} featuredFirst />
  </section>
</Base>
