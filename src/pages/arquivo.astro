---
import Base from '../layouts/Base.astro';
import { getPosts, postUrl } from '../lib/posts';
const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
const short = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', timeZone: 'UTC' });
---

<Base title="Arquivo" description="Todos os artigos publicados, por ano.">
  <div class="container">
    <header class="page-head"><h1>Arquivo</h1><p>{posts.length} artigos publicados.</p></header>
    {years.map((y) => (
      <section>
        <h2 class="archive-year">{y}</h2>
        <ul class="archive-list">
          {posts.filter((p) => p.data.date.getUTCFullYear() === y).map((p) => (
            <li><time datetime={p.data.date.toISOString()}>{short.format(p.data.date)}</time><a href={postUrl(p)}>{p.data.title}</a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
